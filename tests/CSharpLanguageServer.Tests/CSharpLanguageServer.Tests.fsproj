<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- We supply our own entry point (Program.fs) instead of the VSTest-generated one,
         so that `dotnet run`/the built executable can invoke Expecto's own test runner
         directly (see Program.fs and `make test-expecto`). `dotnet test` still works
         unaffected: VSTest loads this assembly by reflection and never calls Main. -->
    <GenerateProgramFile>false</GenerateProgramFile>
    <OutputType>Exe</OutputType>
    <NoWarn>FS0988</NoWarn>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="Tooling.fs" />
    <Compile Include="Fixtures.fs" />
    <Compile Include="DiagnosticTests.fs" />
    <Compile Include="AnalyzerTests.fs" />
    <Compile Include="LocaleTests.fs" />
    <Compile Include="InitializationTests.fs" />
    <Compile Include="ReconfigurationTests.fs" />
    <Compile Include="RenameTests.fs" />
    <Compile Include="CodeActionTests.fs" />
    <Compile Include="DocumentationTests.fs" />
    <Compile Include="DocumentHighlightTests.fs" />
    <Compile Include="DocumentSymbolTests.fs" />
    <Compile Include="HoverTests.fs" />
    <Compile Include="ReferenceTests.fs" />
    <Compile Include="DefinitionTests.fs" />
    <Compile Include="DocumentFormattingTests.fs" />
    <Compile Include="InternalTests.fs" />
    <Compile Include="CompletionTests.fs" />
    <Compile Include="WorkspaceSymbolTests.fs" />
    <Compile Include="SemanticTokenTests.fs" />
    <Compile Include="DiagnoseCommandTests.fs" />
    <Compile Include="SignatureHelpTests.fs" />
    <Compile Include="TypeDefinitionTests.fs" />
    <Compile Include="ImplementationTests.fs" />
    <Compile Include="CSharpMetadataTests.fs" />
    <Compile Include="ProgressReporterTests.fs" />
    <Compile Include="RequestSchedulingTests.fs" />
    <Compile Include="DocumentSyncTests.fs" />
    <Compile Include="WorkspaceTests.fs" />
    <Compile Include="WorkspaceFolderTests.fs" />
    <Compile Include="WorkspaceFolderRegressionTests.fs" />
    <Compile Include="CallHierarchyTests.fs" />
    <Compile Include="FoldingRangeTests.fs" />
    <Compile Include="InlayHintTests.fs" />
    <Compile Include="SourceGeneratorTests.fs" />
    <Compile Include="JsonRpcTests.fs" />
    <!-- Must be last: defines the custom entry point (see GenerateProgramFile above). -->
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <!-- Expecto migration pilot (InternalTests.fs) — coexists with NUnit3TestAdapter above;
         both are VSTest adapters discovered together by `dotnet test`. -->
    <PackageReference Include="Expecto" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NuGet.Frameworks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CSharpLanguageServer\CSharpLanguageServer.fsproj" />
  </ItemGroup>

</Project>
